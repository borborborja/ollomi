{
    "schema_version": 1,
    "images": [
        {
            "name": "api",
            "dockerfile": "deploy/Dockerfile",
            "deployment_workflows": [
                ".github/workflows/ollomi-release.yml"
            ],
            "build_context": ".",
            "source_root": "backend/selfhost",
            "entrypoint_source_root": "backend",
            "workdir": "/srv",
            "entrypoints": [
                "selfhost.main"
            ],
            "image_import_smoke": false,
            "dependency_probe_smoke": true,
            "pull_request_smoke": true
        },
        {
            "name": "stt",
            "dockerfile": "services/speech/Dockerfile",
            "deployment_workflows": [
                ".github/workflows/ollomi-release.yml"
            ],
            "build_context": "services/speech",
            "source_root": "services/speech",
            "workdir": "/srv",
            "entrypoints": [
                "server"
            ],
            "image_import_smoke": true,
            "dependency_probe_smoke": true,
            "dependency_probe_exclusions": {
                "pyannote": "The published CPU image builds with DIARIZATION=false; operators that opt in install pyannote.audio in the Dockerfile's guarded layer.",
                "torch": "The published CPU image builds with DIARIZATION=false; torch is installed only with the optional diarization layer."
            },
            "pull_request_smoke": true
        },
        {
            "name": "voiceprint",
            "dockerfile": "services/voiceprint/Dockerfile",
            "deployment_workflows": [
                ".github/workflows/ollomi-release.yml"
            ],
            "build_context": ".",
            "source_root": "services/voiceprint",
            "workdir": "/srv",
            "entrypoints": [
                "app"
            ],
            "image_import_smoke": true,
            "dependency_probe_smoke": true,
            "pull_request_smoke": true
        }
    ]
}
