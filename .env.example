# Copy this file to .env, replace every CHANGE_ME value, then keep .env private:
#   cp .env.example .env && chmod 600 .env
# Generate every secret independently, for example: openssl rand -hex 32
#
# This baseline has no local AI containers. It is intended for a CPU-only host
# that reaches model servers in the LAN or selected HTTPS providers. To use
# local Whisper/Ollama instead, use scripts/selfhost_init.py and the guide.
COMPOSE_FILE=compose.yaml:deploy/compose.connected.yaml
OLLOMI_HOST_UID=1000
OLLOMI_HOST_GID=1000

OLLOMI_SECRET_KEY=CHANGE_ME_64_HEX_CHARACTERS
POSTGRES_PASSWORD=CHANGE_ME_64_HEX_CHARACTERS
TYPESENSE_API_KEY=CHANGE_ME_64_HEX_CHARACTERS

# Use the LAN address Android will reach. Public use requires the TLS overlay;
# see docs/OLLomi_SELF_HOSTING.es.md before enabling MCP OAuth.
OLLOMI_BIND=0.0.0.0
OLLOMI_PORT=8080
OLLOMI_PUBLIC_URL=http://192.168.1.20:8080
OLLOMI_LOCAL_ONLY=false
OLLOMI_SEED_LOCAL_WHISPER=false
OLLOMI_SEED_LOCAL_OLLAMA=false
OLLOMI_ALLOW_USER_MODEL_SELECTION=false
OLLOMI_AUDIO_RETENTION_DAYS=0

# Optional map previews. Public OpenStreetMap tiles need no API key; the
# backend caches viewed tiles on its data volume for at least seven days.
# For a local OSM tile server, replace only this URL template.
OLLOMI_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Created once on first startup. Delete OLLOMI_ADMIN_PASSWORD from .env after
# you have logged in successfully, then recreate api/worker/scheduler.
OLLOMI_ADMIN_EMAIL=admin@example.com
OLLOMI_ADMIN_PASSWORD=CHANGE_ME_A_LONG_UNIQUE_PASSWORD

# Configure at least one numbered profile for STT, chat and embeddings. The
# server uses ascending numbers as fallback order. LAN services may use HTTP
# with EXTERNAL=false; public providers require HTTPS and EXTERNAL=true.
OLLOMI_STT1_PROVIDER=custom
OLLOMI_STT1_URL=http://192.168.1.30:8000/v1
OLLOMI_STT1_MODEL=whisper-large-v3
OLLOMI_STT1_API_KEY=
OLLOMI_STT1_EXTERNAL=false

OLLOMI_CHAT1_PROVIDER=ollama
OLLOMI_CHAT1_URL=http://192.168.1.30:11434/v1
OLLOMI_CHAT1_MODEL=qwen3:8b
OLLOMI_CHAT1_API_KEY=ollama
OLLOMI_CHAT1_EXTERNAL=false

OLLOMI_EMBEDDING1_PROVIDER=ollama
OLLOMI_EMBEDDING1_URL=http://192.168.1.30:11434/v1
OLLOMI_EMBEDDING1_MODEL=nomic-embed-text
OLLOMI_EMBEDDING1_API_KEY=ollama
OLLOMI_EMBEDDING1_EXTERNAL=false

# Add STT2, CHAT2 or EMBEDDING2 for fallback. Every embedding fallback must
# declare the same explicit dimensions, for example:
# OLLOMI_EMBEDDING1_DIMENSIONS=768
# OLLOMI_EMBEDDING2_PROVIDER=openai
# OLLOMI_EMBEDDING2_MODEL=text-embedding-3-small
# OLLOMI_EMBEDDING2_API_KEY=CHANGE_ME
# OLLOMI_EMBEDDING2_DIMENSIONS=768

# Keep MCP off until a public HTTPS domain and the TLS overlay work end-to-end.
OLLOMI_MCP_ENABLED=false
# OLLOMI_MCP_PUBLIC_URL=https://ollomi.example.com

# Optional separate CPU voiceprint service; never expose it publicly.
# OLLOMI_VOICEPRINT_URL=http://192.168.1.31:8091
# OLLOMI_VOICEPRINT_API_KEY=CHANGE_ME
# OLLOMI_VOICEPRINT_THRESHOLD=0.72
