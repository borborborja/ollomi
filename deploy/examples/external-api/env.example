# Copy this file to .env and replace every CHANGE_ME value.
# The namespace and tag must name this Ollomi fork. A fixed v* tag pins one
# release; use "stable" after the one-time Dockge migration for one-click
# updates to the latest release that passed all publication checks.
# Do not use an upstream Omi image or the main-branch "latest" tag.
OLLOMI_IMAGE_OWNER=CHANGE_ME_WITH_YOUR_GITHUB_OWNER
OLLOMI_IMAGE_TAG=CHANGE_ME_WITH_A_REVIEWED_RELEASE_TAG

# Instance secrets. Generate independent values with: openssl rand -hex 32
OLLOMI_SECRET_KEY=CHANGE_ME_WITH_64_RANDOM_HEX_CHARACTERS
POSTGRES_PASSWORD=CHANGE_ME_WITH_ANOTHER_RANDOM_VALUE
TYPESENSE_API_KEY=CHANGE_ME_WITH_ANOTHER_RANDOM_VALUE

# Initial administrator. Remove OLLOMI_ADMIN_PASSWORD after the first login and
# recreate the backend containers. Existing accounts are never overwritten.
OLLOMI_ADMIN_EMAIL=admin@example.com
OLLOMI_ADMIN_PASSWORD=CHANGE_ME_WITH_AT_LEAST_12_CHARACTERS

# HTTP endpoint exposed to Android. Set PUBLIC_URL to the address used by the
# phone. Put a TLS reverse proxy in front before exposing Ollomi to the Internet.
OLLOMI_BIND=0.0.0.0
OLLOMI_PORT=8090
OLLOMI_PUBLIC_URL=http://192.168.1.20:8090

# Optional public HTTPS and local MCP OAuth: first point this DNS name at the
# server and open inbound TCP ports 80 and 443. Keep OLLOMI_BIND on loopback.
# COMPOSE_PROFILES=public-tls
# OLLOMI_TLS_DOMAIN=ollomi.example.com
# OLLOMI_TLS_BIND=0.0.0.0
# OLLOMI_HTTP_PORT=80
# OLLOMI_HTTPS_PORT=443
# OLLOMI_PUBLIC_URL=https://ollomi.example.com

# Backend policy and limits.
OLLOMI_LOCAL_ONLY=false
OLLOMI_SEED_LOCAL_WHISPER=false
OLLOMI_SEED_LOCAL_OLLAMA=false
# The configured order remains the server fallback chain. Set true only when
# users may choose which configured entry is primary for a task.
OLLOMI_ALLOW_USER_MODEL_SELECTION=false
OLLOMI_AUDIO_RETENTION_DAYS=0
OLLOMI_ACCESS_MINUTES=15
OLLOMI_REFRESH_DAYS=30
OLLOMI_MAX_UPLOAD_MB=1024
OLLOMI_MAX_AUDIO_SECONDS=43200
OLLOMI_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OLLOMI_JOB_LEASE_SECONDS=900

# Optional read-only MCP server. MCP OAuth requires a public HTTPS address;
# set both values before connecting an assistant. Personal MCP keys can also
# be created in Android Developer settings and are shown only once.
OLLOMI_MCP_ENABLED=false
OLLOMI_MCP_PUBLIC_URL=https://ollomi.example.com
OLLOMI_MCP_ACCESS_MINUTES=15
OLLOMI_MCP_REFRESH_DAYS=30

# Optional own-voice recognition. Deploy deploy/examples/voiceprint on the
# separate model server and use the same random key here. Without this service
# Ollomi still diarizes speakers but cannot label the owner's voice persistently.
# OLLOMI_VOICEPRINT_URL=https://voiceprint.example.internal
# OLLOMI_VOICEPRINT_API_KEY=CHANGE_ME_SAME_AS_VOICEPRINT_API_KEY
# OLLOMI_VOICEPRINT_THRESHOLD=0.72

# STT primary: OpenAI-compatible POST /v1/audio/transcriptions.
OLLOMI_STT1_PROVIDER=openai
OLLOMI_STT1_NAME=OpenAI Whisper
OLLOMI_STT1_URL=https://api.openai.com/v1
OLLOMI_STT1_MODEL=whisper-1
OLLOMI_STT1_API_KEY=CHANGE_ME_OPENAI_API_KEY
OLLOMI_STT1_EXTERNAL=true
OLLOMI_STT1_OPTIONS={"response_format":"verbose_json"}

# Chat primary: OpenAI-compatible POST /v1/chat/completions.
OLLOMI_CHAT1_PROVIDER=openrouter
OLLOMI_CHAT1_NAME=OpenRouter
OLLOMI_CHAT1_URL=https://openrouter.ai/api/v1
OLLOMI_CHAT1_MODEL=openai/gpt-4.1-mini
OLLOMI_CHAT1_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
OLLOMI_CHAT1_EXTERNAL=true
OLLOMI_CHAT1_OPTIONS={"max_tokens":2048}

# Embeddings primary: OpenAI-compatible POST /v1/embeddings.
OLLOMI_EMBEDDING1_PROVIDER=openai
OLLOMI_EMBEDDING1_NAME=OpenAI embeddings
OLLOMI_EMBEDDING1_URL=https://api.openai.com/v1
OLLOMI_EMBEDDING1_MODEL=text-embedding-3-small
OLLOMI_EMBEDDING1_API_KEY=CHANGE_ME_OPENAI_API_KEY
OLLOMI_EMBEDDING1_EXTERNAL=true
OLLOMI_EMBEDDING1_OPTIONS={}
OLLOMI_EMBEDDING1_DIMENSIONS=1024

# Optional fallbacks. Remove the leading # only after replacing every value.
# Numbered entries are attempted in order. Every embedding fallback must use
# the same DIMENSIONS value as EMBEDDING1. Android only offers configured
# entries as a user-selectable primary when OLLOMI_ALLOW_USER_MODEL_SELECTION
# is true; the remaining entries stay available as fallback.
#
# Gemini is batch STT. It uploads the recording to the Google Files API and
# uses gemini-3.5-transcribe. Ollomi enables speaker diarization by default;
# configure optional word timestamps with this current Interactions API shape.
# OLLOMI_STT2_PROVIDER=gemini
# OLLOMI_STT2_NAME=Gemini Transcribe
# OLLOMI_STT2_MODEL=gemini-3.5-transcribe
# OLLOMI_STT2_API_KEY=CHANGE_ME_GEMINI_API_KEY
# OLLOMI_STT2_EXTERNAL=true
# OLLOMI_STT2_OPTIONS={"transcription_config":{"mode":{"type":"verbatim","timestamp_granularities":["word"]}}}
#
# AssemblyAI and Deepgram use their native STT APIs and preserve diarization
# labels when their provider returns them.
# OLLOMI_STT3_PROVIDER=assemblyai
# OLLOMI_STT3_MODEL=universal-3-5-pro
# OLLOMI_STT3_API_KEY=CHANGE_ME_ASSEMBLYAI_API_KEY
# OLLOMI_STT3_EXTERNAL=true
# OLLOMI_STT3_OPTIONS={}
# OLLOMI_STT4_PROVIDER=deepgram
# OLLOMI_STT4_MODEL=nova-3
# OLLOMI_STT4_API_KEY=CHANGE_ME_DEEPGRAM_API_KEY
# OLLOMI_STT4_EXTERNAL=true
# OLLOMI_STT4_OPTIONS={}
#
# OLLOMI_CHAT2_PROVIDER=openai
# OLLOMI_CHAT2_NAME=OpenAI chat fallback
# OLLOMI_CHAT2_URL=https://api.openai.com/v1
# OLLOMI_CHAT2_MODEL=gpt-4.1-mini
# OLLOMI_CHAT2_API_KEY=CHANGE_ME
# OLLOMI_CHAT2_EXTERNAL=true
# OLLOMI_CHAT2_OPTIONS={"max_tokens":2048}
#
# OLLOMI_EMBEDDING2_PROVIDER=voyage
# OLLOMI_EMBEDDING2_NAME=Voyage embeddings
# OLLOMI_EMBEDDING2_MODEL=voyage-4-lite
# OLLOMI_EMBEDDING2_API_KEY=CHANGE_ME_VOYAGE_API_KEY
# OLLOMI_EMBEDDING2_EXTERNAL=true
# OLLOMI_EMBEDDING2_OPTIONS={}
# OLLOMI_EMBEDDING2_DIMENSIONS=1024
# OLLOMI_EMBEDDING3_PROVIDER=cohere
# OLLOMI_EMBEDDING3_NAME=Cohere embeddings
# OLLOMI_EMBEDDING3_MODEL=embed-v4.0
# OLLOMI_EMBEDDING3_API_KEY=CHANGE_ME_COHERE_API_KEY
# OLLOMI_EMBEDDING3_EXTERNAL=true
# OLLOMI_EMBEDDING3_OPTIONS={}
# OLLOMI_EMBEDDING3_DIMENSIONS=1024

# LAN Ollama alternative for chat or embeddings. A private HTTP endpoint must
# use EXTERNAL=false; OLLOMI_LOCAL_ONLY=false still enables the inference net.
# OLLOMI_CHAT1_PROVIDER=ollama
# OLLOMI_CHAT1_NAME=Ollama LAN
# OLLOMI_CHAT1_URL=http://192.168.1.10:11434/v1
# OLLOMI_CHAT1_MODEL=qwen3:8b
# OLLOMI_CHAT1_API_KEY=ollama
# OLLOMI_CHAT1_EXTERNAL=false
# OLLOMI_CHAT1_OPTIONS={"prompt_suffix":"/no_think","max_tokens":2048}
