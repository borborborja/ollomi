# Copy this file to .env and replace every CHANGE_ME value.
# Pin a release tag for reproducible upgrades. Use latest only if you accept
# receiving every main-branch publication.
OLLOMI_IMAGE_TAG=v0.3.1

# Instance secrets. Generate independent values with: openssl rand -hex 32
OLLOMI_SECRET_KEY=CHANGE_ME_WITH_64_RANDOM_HEX_CHARACTERS
POSTGRES_PASSWORD=CHANGE_ME_WITH_ANOTHER_RANDOM_VALUE
TYPESENSE_API_KEY=CHANGE_ME_WITH_ANOTHER_RANDOM_VALUE

# Initial administrator. Remove OLLOMI_ADMIN_PASSWORD after the first login and
# recreate the backend containers. Existing accounts are never overwritten.
OLLOMI_ADMIN_EMAIL=admin@example.com
OLLOMI_ADMIN_PASSWORD=CHANGE_ME_WITH_AT_LEAST_12_CHARACTERS

# HTTP endpoint exposed to Android. Set PUBLIC_URL to the address used by the
# phone. Put a TLS reverse proxy in front before exposing Ollomi to the Internet.
OLLOMI_BIND=0.0.0.0
OLLOMI_PORT=8090
OLLOMI_PUBLIC_URL=http://192.168.1.20:8090

# Backend policy and limits.
OLLOMI_LOCAL_ONLY=false
OLLOMI_SEED_LOCAL_WHISPER=false
OLLOMI_SEED_LOCAL_OLLAMA=false
OLLOMI_AUDIO_RETENTION_DAYS=0
OLLOMI_ACCESS_MINUTES=15
OLLOMI_REFRESH_DAYS=30
OLLOMI_MAX_UPLOAD_MB=1024
OLLOMI_MAX_AUDIO_SECONDS=43200
OLLOMI_JOB_LEASE_SECONDS=900

# STT primary: OpenAI-compatible POST /v1/audio/transcriptions.
OLLOMI_STT1_PROVIDER=openai
OLLOMI_STT1_NAME=OpenAI Whisper
OLLOMI_STT1_URL=https://api.openai.com/v1
OLLOMI_STT1_MODEL=whisper-1
OLLOMI_STT1_API_KEY=CHANGE_ME_OPENAI_API_KEY
OLLOMI_STT1_EXTERNAL=true
OLLOMI_STT1_OPTIONS={"response_format":"verbose_json"}

# Chat primary: OpenAI-compatible POST /v1/chat/completions.
OLLOMI_CHAT1_PROVIDER=openrouter
OLLOMI_CHAT1_NAME=OpenRouter
OLLOMI_CHAT1_URL=https://openrouter.ai/api/v1
OLLOMI_CHAT1_MODEL=openai/gpt-4.1-mini
OLLOMI_CHAT1_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
OLLOMI_CHAT1_EXTERNAL=true
OLLOMI_CHAT1_OPTIONS={"max_tokens":2048}

# Embeddings primary: OpenAI-compatible POST /v1/embeddings.
OLLOMI_EMBEDDING1_PROVIDER=openai
OLLOMI_EMBEDDING1_NAME=OpenAI embeddings
OLLOMI_EMBEDDING1_URL=https://api.openai.com/v1
OLLOMI_EMBEDDING1_MODEL=text-embedding-3-small
OLLOMI_EMBEDDING1_API_KEY=CHANGE_ME_OPENAI_API_KEY
OLLOMI_EMBEDDING1_EXTERNAL=true
OLLOMI_EMBEDDING1_OPTIONS={}
OLLOMI_EMBEDDING1_DIMENSIONS=1536

# Optional fallbacks. Remove the leading # only after replacing every value.
# Numbered entries are attempted in order. Every embedding fallback must use
# the same DIMENSIONS value as EMBEDDING1.
# OLLOMI_STT2_PROVIDER=custom
# OLLOMI_STT2_NAME=Compatible STT fallback
# OLLOMI_STT2_URL=https://speech.example.com/v1
# OLLOMI_STT2_MODEL=whisper-large-v3
# OLLOMI_STT2_API_KEY=CHANGE_ME
# OLLOMI_STT2_EXTERNAL=true
# OLLOMI_STT2_OPTIONS={"response_format":"json"}
#
# OLLOMI_CHAT2_PROVIDER=openai
# OLLOMI_CHAT2_NAME=OpenAI chat fallback
# OLLOMI_CHAT2_URL=https://api.openai.com/v1
# OLLOMI_CHAT2_MODEL=gpt-4.1-mini
# OLLOMI_CHAT2_API_KEY=CHANGE_ME
# OLLOMI_CHAT2_EXTERNAL=true
# OLLOMI_CHAT2_OPTIONS={"max_tokens":2048}
#
# OLLOMI_EMBEDDING2_PROVIDER=custom
# OLLOMI_EMBEDDING2_NAME=Compatible embeddings fallback
# OLLOMI_EMBEDDING2_URL=https://embeddings.example.com/v1
# OLLOMI_EMBEDDING2_MODEL=compatible-embedding-model
# OLLOMI_EMBEDDING2_API_KEY=CHANGE_ME
# OLLOMI_EMBEDDING2_EXTERNAL=true
# OLLOMI_EMBEDDING2_OPTIONS={}
# OLLOMI_EMBEDDING2_DIMENSIONS=1536

# LAN Ollama alternative for chat or embeddings. A private HTTP endpoint must
# use EXTERNAL=false; OLLOMI_LOCAL_ONLY=false still enables the inference net.
# OLLOMI_CHAT1_PROVIDER=ollama
# OLLOMI_CHAT1_NAME=Ollama LAN
# OLLOMI_CHAT1_URL=http://192.168.1.10:11434/v1
# OLLOMI_CHAT1_MODEL=qwen3:8b
# OLLOMI_CHAT1_API_KEY=ollama
# OLLOMI_CHAT1_EXTERNAL=false
# OLLOMI_CHAT1_OPTIONS={"prompt_suffix":"/no_think","max_tokens":2048}
