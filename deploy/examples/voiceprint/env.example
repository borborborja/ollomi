# Copy to .env. The same random key is configured as OLLOMI_VOICEPRINT_API_KEY
# on the primary Ollomi backend; do not publish this port directly to Internet.
VOICEPRINT_API_KEY=CHANGE_ME_WITH_A_32_BYTE_RANDOM_SECRET
VOICEPRINT_BIND=127.0.0.1
VOICEPRINT_PORT=8091
# Required only by compose.ghcr.yaml, which pulls the image published by this
# exact Ollomi fork and versioned release.
OLLOMI_IMAGE_OWNER=CHANGE_ME_WITH_YOUR_GITHUB_OWNER
OLLOMI_IMAGE_TAG=CHANGE_ME_WITH_A_REVIEWED_RELEASE_TAG
# The source-build Compose pins this public Apache-2.0 ECAPA model revision
# into the image. Change it only when rebuilding a reviewed image; it is not a
# runtime provider URL and the running service stays offline.
VOICEPRINT_MODEL_REPOSITORY=speechbrain/spkrec-ecapa-voxceleb
VOICEPRINT_MODEL_REVISION=0f99f2d0ebe89ac095bcc5903c4dd8f72b367286
# Conservative defaults for the local speaker-turn fallback. Provider-native
# diarization remains preferable when the selected STT offers it.
# VOICEPRINT_MAX_DIARIZATION_SECONDS=150
# VOICEPRINT_DIARIZATION_WINDOW_SECONDS=3
# VOICEPRINT_DIARIZATION_STEP_SECONDS=1.5
# VOICEPRINT_DIARIZATION_THRESHOLD=0.68
# VOICEPRINT_MAX_SPEAKERS=8
